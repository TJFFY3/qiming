# 启鸣 AI · 教学 Agent 工作台
# 单镜像：Node 构建前端 → python:3.12-slim 运行 FastAPI，后端直接提供 frontend/dist
FROM node:22-slim AS frontend
ENV npm_config_registry=https://registry.npmmirror.com
WORKDIR /build

# 只先拷清单与锁文件，装依赖的层可被后续源码改动复用
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    DATA_DIR=/app/data

WORKDIR /app
COPY backend/requirements.txt ./backend/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r backend/requirements.txt

# 运行时代码、vendor 能力包（Word/PPTX 模板与脚本）与前端构建产物
COPY backend/ ./backend/
COPY vendor/ ./vendor/
COPY --from=frontend /build/dist ./frontend/dist

# 仓库里的 config.example.py 不是可导入的模块名，拷成可导入名，作为 Settings 唯一来源
COPY backend/app/config.example.py ./backend/app/config_defaults.py
# 凭据只从环境变量读取，不写入仓库；覆盖仓库里被忽略的 config.py
COPY .sealos/config_from_env.py ./backend/app/config.py

EXPOSE 8010
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8010"]
