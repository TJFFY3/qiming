{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chemistry-teaching:outline:v2",
  "title": "导学纲规范化内容协议",
  "description": "render_outline.py 接受旧格式并转换为此协议。表格rows只含数据行，表头另计。",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/run"
            }
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    },
                    "type": {
                      "const": "paragraph"
                    },
                    "content": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "content"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    },
                    "type": {
                      "const": "table"
                    },
                    "headers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "items": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/text"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "widths_cm": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "min_row_height_cm": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "headers",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "thinking": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/run"
            }
          }
        ]
      }
    },
    "schedule_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "goals",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "sub": {
          "type": "boolean"
        },
        "sup": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "bold": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "charge": {
          "type": "boolean"
        },
        "condition": {
          "type": "boolean"
        },
        "isotope": {
          "type": "object",
          "properties": {
            "mass": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              ]
            },
            "atomic": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              ]
            }
          },
          "required": [
            "mass",
            "atomic"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      ]
    }
  }
}